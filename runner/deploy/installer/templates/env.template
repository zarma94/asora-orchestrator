# ASORA ingest instance — /opt/orchestrator/.env  (root:orchestrator 640 — NEVER chown/chmod differently)
# Generated by install.sh; __PLACEHOLDERS__ are filled at install time.

DATABASE_URL=postgres://asora:__PGPASS__@127.0.0.1:5434/asora
ORCH_RUNNER_KEY=__RUNNERKEY__
API_HOST=127.0.0.1
API_PORT=8787

# Paths (client instance is self-contained under /opt/orchestrator — no Nextcloud)
DOCS_ROOT=/opt/orchestrator
ORCHESTRATOR_DIR=/opt/orchestrator/hub
BRAIN_DIR=/opt/orchestrator/brain
REPOS_DIR=/opt/orchestrator/repos
ARTIFACTS_DIR=/opt/orchestrator/artifacts
PROJECTS_LOCAL=/opt/orchestrator/projects.local.json

# Ingest pipeline
INGEST_INBOX=/opt/orchestrator/inbox
INGEST_DIR=/opt/orchestrator/ingest
# REQUIRED before the sweep runs: colon-separated READ-ONLY document roots to ingest, e.g.
# INGEST_SOURCE_DIRS=/srv/ceg-documents
INGEST_SOURCE_DIRS=
INGEST_SWEEP_BATCH=20
# Master companies for this instance (JSON). ACME install = ACME only:
INGEST_COMPANIES={"ceg":{"folder":"ACME","desc":"ACME Group AG - company/tax setups, real estate (Sample Project Morocco, Sample Project B, SampleRegion), ACME Stake tokenisation, broker platform, client work"}}

# Claude auth: EITHER `sudo -u orchestrator claude login` (subscription, preferred)
# OR uncomment an API key (paid):
# ANTHROPIC_API_KEY=

# Runner pacing (gentle on a shared box)
RUNNER_CONCURRENCY=1
JOB_TIMEOUT_MIN=15
JOB_MAX_BUDGET_USD=3

# Telegram (optional but recommended — the router ASKS here when it cannot place a doc;
# leave empty to run silent). Bot token + the OWNER's numeric chat id only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hardcoded access rules (roles / restricted users). ROOT-owned; edit as root only.
# Missing or empty roles = owner-only. See README "Access control".
ACCESS_CONFIG=/opt/orchestrator/access.json

# Slack front-end (optional — channel-per-project/company, approve buttons; Socket Mode).
# Fill both tokens + map channels in channels.json, then: systemctl enable --now orchestrator-slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
CHANNELS_CONFIG=/opt/orchestrator/channels.json
