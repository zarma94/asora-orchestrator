# Orchestrator runner — environment. On the box: /opt/orchestrator/.env, root-owned, chmod 600.
# NEVER commit a filled-in copy. NEVER put values in jobs, logs, results, or chat.

# --- required (both services fail closed without these) ---
DATABASE_URL=postgres://orchestrator:CHANGE_ME@127.0.0.1:5432/orchestrator
ORCH_RUNNER_KEY=            # generate: openssl rand -hex 32 — the Jobs API auth key (Cowork holds the other copy)
OPS_API_KEY=                # generate: openssl rand -hex 32 — the /api/ops (ops-runner) key. SEPARATE key.
                            #   No IP-allowlist on this box (Cowork = dynamic cloud IP): destructive verbs need a human tap.
                            #   Empty ⇒ /api/ops is disabled. Cowork's copy lives in Orchestrator/secrets/orchestrator-ops.env.
                            #   The orchestrator-ops executor does NOT need this key (it reads the DB) — keep it out of ops.env.

# --- paths ---
DOCS_ROOT=/mnt/nextcloud            # rclone NC mount, READ-ONLY (see RUNBOOK §mount)
# ORCHESTRATOR_DIR=/mnt/nextcloud/Orchestrator   # default: $DOCS_ROOT/Orchestrator
REPOS_DIR=/opt/orchestrator/repos   # writable git clones for write_mode=git projects
ARTIFACTS_DIR=/opt/orchestrator/artifacts

# --- api ---
API_HOST=127.0.0.1                  # never expose directly; nginx terminates TLS
API_PORT=8787

# --- runner behavior ---
RUNNER_CONCURRENCY=2
JOB_TIMEOUT_MIN=30
JOB_MAX_BUDGET_USD=5                # per-job claude spend cap
STALE_RUNNING_MIN=45
POLL_INTERVAL_SEC=15
SCHEDULE_TZ=Europe/Ljubljana
CLAUDE_BIN=claude
# ANTHROPIC_API_KEY=  # LEAVE UNSET. Claude auth = the `claude login` subscription (OAuth in ~/.claude). Setting this switches claude -p to PAID per-token API billing and overrides the subscription. Only set it if you deliberately want API billing.

# --- integrations (optional; features disable cleanly when empty) ---
EMS_BASE_URL=https://ems.example.com
EMS_TASKS_API_KEY=                  # from Orchestrator/secrets/ems.env (EMS Admin → Settings)
TELEGRAM_BOT_TOKEN=                 # digest delivery to MATT ONLY
TELEGRAM_CHAT_ID=                   # the owner's own chat id — never a group, never a client
EMS_HYGIENE_APPLY=false             # opt-in: allow ems-hygiene to PATCH task statuses

# --- calendar (read-only, daily brief) ---
CALDAV_URL=https://your-nextcloud.example.com/remote.php/dav/calendars/mzargi/
CALDAV_USER=mzargi
CALDAV_PASS=                        # same app-password as the NC WebDAV mount (rclone reveal <obscured>)
CALDAV_EXPECTED=gmail-personal,mzk,ceg   # brief flags any of these missing — mzk/ceg subscriptions pending

# --- mail (mail-triage) ---
# MAIL_DIR=/root/.mail              # default ~/.mail — deploy the owner's tooling + .env + .oauth_mzk.json there (600)
PYTHON_BIN=python3

# Model policy (CLI aliases so they track the current version). Subscription = Max-plan usage, not $.
CLAUDE_DEFAULT_MODEL=sonnet   # most jobs
CLAUDE_HEAVY_MODEL=opus       # ingest, research, decision, pre-mortem, auditor, pageindex
CLAUDE_LIGHT_MODEL=haiku      # ems-sync, mail-triage, hygiene
